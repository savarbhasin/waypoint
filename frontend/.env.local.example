NEXT_PUBLIC_WORKER_URL=http://localhost:8787
WORKER_URL=http://localhost:8787

# Postgres (local dev via docker compose at repo root: docker compose up -d postgres)
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI — used for workflow enrichment on extension import
OPENAI_API_KEY=
